{
  "name": "node-express-sqlite-pm2-example",
  "version": "1.0.0",
  "description": "A Node.js + Express + SQLite + PM2 example app with Docker multi-entrypoint setup",
  "private": true,
  "workspaces": [
    "backend",
    "db"
  ],
  "scripts": {
    "dev:backend": "turbo run dev --filter=backend",
    "dev:db": "turbo run dev --filter=db",
    "build": "turbo run build",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop all",
    "logs": "pm2 logs",
    "dev": "concurrently \"npm run dev:db\" \"npm run dev:backend\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.7.1",
    "turbo": "^1.12.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
