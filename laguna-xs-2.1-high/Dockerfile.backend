FROM node:22-alpine AS development

# Install dependencies for tsx and development
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    curl

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies including dev dependencies
RUN npm install

# Copy source files
COPY tsconfig.json .
COPY src ./src
COPY .eslintrc.json .
COPY .prettierrc ./
COPY entrypoints ./entrypoints

# Make entrypoints executable
RUN chmod +x entrypoints/*.sh

# Expose port
EXPOSE 3000

# Default command - run development server with tsx
CMD ["npm", "run", "dev"]
